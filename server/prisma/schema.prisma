// MiniSaaS ERP 数据模型
// 5 张表：User（用户）、Customer（客户）、Product（商品）、
//         Order（订单）、OrderItem（订单明细）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户（登录账号）
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String // bcrypt 哈希，绝不存明文
  role         String   @default("SALES") // ADMIN 管理员 / SALES 销售
  createdAt    DateTime @default(now())
}

// 客户
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String? // 联系人
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  orders    Order[]
}

// 商品
model Product {
  id        Int         @id @default(autoincrement())
  sku       String      @unique // 库存单位编码
  name      String
  price     Float
  stock     Int         @default(0)
  category  String?
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

// 订单
model Order {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique // 订单号
  customerId  Int
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      String      @default("PENDING")
  // 状态流转：PENDING(待支付) -> PAID(已支付) -> SHIPPED(已发货) -> DONE(已完成)
  //                     \-> CANCELLED(已取消，回补库存)
  totalAmount Float
  remark      String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

// 订单明细（一个订单多行商品）
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float // 下单时的单价快照，防止商品改价影响历史订单
}
