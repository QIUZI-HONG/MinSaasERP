# ============================================================
# MiniSaaS ERP 后端环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# 严禁将 .env 提交到版本库
# ============================================================

# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必换成随机长字符串，例如：
#   openssl rand -base64 48
# 或使用 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# MySQL 连接串（本地/云数据库通用）
# 格式: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# 云端 MySQL（如 TiDB Cloud Serverless 免费版）:
#   mysql://USER:PASSWORD@HOST:4000/DBNAME?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/minierp"

# CORS 允许来源（逗号分隔；无 Origin 的请求不受限）
# 生产环境务必配置为真实前端域名，例如 https://erp.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
