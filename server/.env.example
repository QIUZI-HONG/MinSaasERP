# ============================================================
# MiniSaaS ERP 后端环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# 严禁将 .env 提交到版本库
# ============================================================

# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必换成随机长字符串，例如：
#   openssl rand -base64 48
# 或使用 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite 数据库文件（相对 prisma/schema.prisma 所在目录）
DATABASE_URL="file:./dev.db"

# CORS 允许来源（逗号分隔；无 Origin 的请求不受限）
# 生产环境务必配置为真实前端域名，例如 https://erp.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
